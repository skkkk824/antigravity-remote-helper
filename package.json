{
  "name": "antigravity-remote-helper",
  "displayName": "%ext.displayName%",
  "description": "%ext.description%",
  "version": "0.3.0",
  "publisher": "skkkk824",
  "license": "MIT",
  "icon": "media/logo.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/skkkk824/antigravity-remote-helper.git"
  },
  "homepage": "https://github.com/skkkk824/antigravity-remote-helper#readme",
  "bugs": {
    "url": "https://github.com/skkkk824/antigravity-remote-helper/issues"
  },
  "galleryBanner": {
    "color": "#0F172A",
    "theme": "dark"
  },
  "keywords": [
    "antigravity",
    "ssh",
    "remote",
    "offline",
    "air-gapped",
    "proxy",
    "tunnel",
    "agy"
  ],
  "engines": {
    "vscode": "^1.90.0"
  },
  "extensionKind": [
    "ui"
  ],
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./src/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "antigravityRemoteHelper",
          "title": "%viewContainer.title%",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "antigravityRemoteHelper": [
        {
          "id": "antigravityRemoteHelperHosts",
          "name": "%view.hosts.name%"
        }
      ]
    },
    "commands": [
      {
        "command": "antigravityRemoteHelper.deployAndConnect",
        "title": "%cmd.deployAndConnect%",
        "icon": "$(plug)"
      },
      {
        "command": "antigravityRemoteHelper.deployAndConnectCurrentWindow",
        "title": "%cmd.deployAndConnectCurrentWindow%",
        "icon": "$(arrow-right)"
      },
      {
        "command": "antigravityRemoteHelper.deployOnly",
        "title": "%cmd.deployOnly%",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "antigravityRemoteHelper.startTunnelForHost",
        "title": "%cmd.startTunnelForHost%",
        "icon": "$(radio-tower)"
      },
      {
        "command": "antigravityRemoteHelper.stopTunnelForHost",
        "title": "%cmd.stopTunnelForHost%",
        "icon": "$(debug-disconnect)"
      },
      {
        "command": "antigravityRemoteHelper.downloadCache",
        "title": "%cmd.downloadCache%",
        "icon": "$(cloud-download)"
      },
      {
        "command": "antigravityRemoteHelper.clearCache",
        "title": "%cmd.clearCache%",
        "icon": "$(trash)"
      },
      {
        "command": "antigravityRemoteHelper.openSshConfig",
        "title": "%cmd.openSshConfig%",
        "icon": "$(gear)"
      },
      {
        "command": "antigravityRemoteHelper.refreshHosts",
        "title": "%cmd.refreshHosts%",
        "icon": "$(refresh)"
      },
      {
        "command": "antigravityRemoteHelper.showLog",
        "title": "%cmd.showLog%",
        "icon": "$(output)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "antigravityRemoteHelper.deployAndConnect",
          "when": "view == antigravityRemoteHelperHosts",
          "group": "navigation@1"
        },
        {
          "command": "antigravityRemoteHelper.clearCache",
          "when": "view == antigravityRemoteHelperHosts",
          "group": "navigation@2"
        },
        {
          "command": "antigravityRemoteHelper.openSshConfig",
          "when": "view == antigravityRemoteHelperHosts",
          "group": "navigation@3"
        },
        {
          "command": "antigravityRemoteHelper.refreshHosts",
          "when": "view == antigravityRemoteHelperHosts",
          "group": "navigation@4"
        }
      ],
      "view/item/context": [
        {
          "command": "antigravityRemoteHelper.deployAndConnectCurrentWindow",
          "when": "viewItem == sshHost || viewItem == sshHostTunneled",
          "group": "inline@1"
        },
        {
          "command": "antigravityRemoteHelper.deployAndConnect",
          "when": "viewItem == sshHost || viewItem == sshHostTunneled",
          "group": "inline@2"
        },
        {
          "command": "antigravityRemoteHelper.deployOnly",
          "when": "viewItem == sshHost || viewItem == sshHostTunneled",
          "group": "1_actions@1"
        },
        {
          "command": "antigravityRemoteHelper.startTunnelForHost",
          "when": "viewItem == sshHost",
          "group": "1_actions@2"
        },
        {
          "command": "antigravityRemoteHelper.stopTunnelForHost",
          "when": "viewItem == sshHostTunneled",
          "group": "1_actions@2"
        }
      ]
    },
    "configuration": {
      "title": "Antigravity Remote Helper",
      "scope": "application",
      "properties": {
        "antigravityRemoteHelper.sshPath": {
          "type": "string",
          "default": "",
          "scope": "application",
          "description": "%cfg.sshPath%"
        },
        "antigravityRemoteHelper.scpPath": {
          "type": "string",
          "default": "",
          "scope": "application",
          "description": "%cfg.scpPath%"
        },
        "antigravityRemoteHelper.configFile": {
          "type": "string",
          "default": "",
          "scope": "application",
          "description": "%cfg.configFile%"
        },
        "antigravityRemoteHelper.proxyUrl": {
          "type": "string",
          "default": "",
          "scope": "application",
          "description": "%cfg.proxyUrl%"
        },
        "antigravityRemoteHelper.enableProxyTunnel": {
          "type": "boolean",
          "default": true,
          "scope": "application",
          "description": "%cfg.enableProxyTunnel%"
        },
        "antigravityRemoteHelper.enableTerminalProxy": {
          "type": "boolean",
          "default": true,
          "scope": "application",
          "description": "%cfg.enableTerminalProxy%"
        },
        "antigravityRemoteHelper.tunnelPort": {
          "type": "number",
          "default": 17891,
          "scope": "application",
          "description": "%cfg.tunnelPort%"
        },
        "antigravityRemoteHelper.deployAgyCli": {
          "type": "boolean",
          "default": true,
          "scope": "application",
          "description": "%cfg.deployAgyCli%"
        },
        "antigravityRemoteHelper.forceRedeploy": {
          "type": "boolean",
          "default": false,
          "scope": "application",
          "description": "%cfg.forceRedeploy%"
        },
        "antigravityRemoteHelper.connectTimeoutSeconds": {
          "type": "number",
          "default": 20,
          "scope": "application",
          "description": "%cfg.connectTimeoutSeconds%"
        }
      }
    }
  }
}
